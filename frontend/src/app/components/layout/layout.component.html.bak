<div class="min-h-screen bg-gray-50 flex relative">

    <!-- Mobile Sidebar Overlay -->
    <div *ngIf="isSidebarOpen" (click)="toggleSidebar()"
        class="fixed inset-0 bg-gray-900/50 z-40 md:hidden backdrop-blur-sm transition-opacity"></div>

    <!-- Sidebar -->
    <aside
        class="fixed md:sticky top-0 left-0 z-50 h-screen bg-slate-900 text-white transition-all duration-300 ease-in-out transform md:translate-x-0 flex flex-col shadow-2xl"
        [class.-translate-x-full]="!isSidebarOpen" [class.translate-x-0]="isSidebarOpen" [class.w-64]="!isCollapsed"
        [class.w-20]="isCollapsed">

        <!-- Logo and Toggle -->
        <div class="h-20 flex items-center justify-between px-4 border-b border-slate-800">
            <div class="flex items-center gap-3 overflow-hidden" [class.justify-center]="isCollapsed"
                [class.w-full]="isCollapsed">
                <div class="w-20 h-20 bg-slate-800 rounded-lg flex items-center justify-center shadow-lg shadow-slate-800/20">
                    <img src="/NEXUSHR.png" alt="NexusHR Logo" class="h-20 w-auto">
                </div>
            </div>

            <!-- Toggle Button (only visible on desktop) -->
            <button (click)="toggleCollapse()" *ngIf="!isCollapsed"
                class="hidden md:flex text-slate-400 hover:text-white p-1 rounded-md transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path>
                </svg>
            </button>
        </div>

        <!-- Collapsed Toggle Button (Centered) -->
        <div *ngIf="isCollapsed" class="hidden md:flex justify-center py-2 border-b border-slate-800/50">
            <button (click)="toggleCollapse()" class="text-slate-400 hover:text-white p-1 rounded-md transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7">
                    </path>
                </svg>
            </button>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto overflow-x-hidden">
            <div class="px-4 mb-2 text-xs font-semibold text-slate-500 uppercase tracking-wider" *ngIf="!isCollapsed">
                Menu</div>
            <div class="h-px bg-slate-800 mx-4 mb-4" *ngIf="isCollapsed"></div>

            <!-- Common Dashboard Link -->
            <a [routerLink]="['/dashboard', (user$ | async)?.role === 'staff' ? 'employee' : (user$ | async)?.role]"
                routerLinkActive="bg-blue-600 text-white shadow-lg shadow-blue-600/20"
                [routerLinkActiveOptions]="{exact: false}"
                class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group mb-2 relative"
                [class.justify-center]="isCollapsed">
                <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                    [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z">
                    </path>
                </svg>
                <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Dashboard</span>

                <!-- Tooltip -->
                <span *ngIf="isCollapsed"
                    class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                    Dashboard
                </span>
            </a>

            <ng-container *ngIf="user$ | async as user">
                <!-- HR Links -->
                <ng-container *ngIf="user.role === 'hr'">
                    <div class="px-4 mt-4 mb-2 text-xs font-semibold text-slate-500 uppercase tracking-wider"
                        *ngIf="!isCollapsed">HR
                        Management</div>
                    <div class="h-px bg-slate-800 mx-4 my-4" *ngIf="isCollapsed"></div>

                    <a routerLink="/dashboard/hr" routerLinkActive="bg-blue-600 text-white shadow-lg shadow-blue-600/20"
                        [routerLinkActiveOptions]="{exact: true}"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group mb-1 relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z">
                            </path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Overview</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Overview
                        </span>
                    </a>

                    <a routerLink="/dashboard/hr/recruitment"
                        routerLinkActive="bg-blue-600 text-white shadow-lg shadow-blue-600/20"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group mb-1 relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z">
                            </path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Recruitment</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Recruitment
                        </span>
                    </a>

                    <!-- Employees Dropdown -->
                    <div class="mb-1 relative" routerLinkActive="active-parent" #employeesRla="routerLinkActive">
                        <button (click)="toggleEmployeesMenu()" [class.bg-slate-800]="isEmployeesMenuOpen || employeesRla.isActive"
                            [class.text-white]="isEmployeesMenuOpen || employeesRla.isActive"
                            class="w-full flex items-center justify-between px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group"
                            [class.justify-center]="isCollapsed">
                            <div class="flex items-center">
                                <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                                    [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z">
                                    </path>
                                </svg>
                                <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Employees</span>
                            </div>
                            <svg [class.rotate-180]="isEmployeesMenuOpen" *ngIf="!isCollapsed"
                                class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Employees
                        </span>

                        <!-- Submenu -->
                        <div *ngIf="isEmployeesMenuOpen" class="mt-1 pl-11 space-y-1">
                            <a routerLink="/dashboard/hr/employees/all" routerLinkActive="bg-blue-600/10 text-blue-400 font-semibold"
                                class="block px-3 py-2 -ml-3 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800/50 transition-colors">
                                All Employees
                            </a>
                            <a routerLink="/dashboard/hr/employees/departments"
                                routerLinkActive="bg-blue-600/10 text-blue-400 font-semibold"
                                class="block px-3 py-2 -ml-3 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800/50 transition-colors">
                                Departments
                            </a>
                            <a routerLink="/dashboard/hr/employees/designations"
                                routerLinkActive="bg-blue-600/10 text-blue-400 font-semibold"
                                class="block px-3 py-2 -ml-3 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800/50 transition-colors">
                                Designations
                            </a>
                        </div>
                    </div>

                    <a routerLink="/dashboard/time-attendance"
                        routerLinkActive="bg-blue-600 text-white shadow-lg shadow-blue-600/20"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group mb-1 relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Time & Attendance</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Time & Attendance
                        </span>
                    </a>

                    <!-- Leave Dropdown -->
                    <div class="mb-1 relative" routerLinkActive="active-parent" #hrLeaveRla="routerLinkActive">
                        <button (click)="toggleLeaveMenu()" [class.bg-slate-800]="isLeaveMenuOpen || hrLeaveRla.isActive"
                            [class.text-white]="isLeaveMenuOpen || hrLeaveRla.isActive"
                            class="w-full flex items-center justify-between px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group"
                            [class.justify-center]="isCollapsed">
                            <div class="flex items-center">
                                <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                                    [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                                    </path>
                                </svg>
                                <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Leave</span>
                            </div>
                            <svg [class.rotate-180]="isLeaveMenuOpen" *ngIf="!isCollapsed"
                                class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Leave
                        </span>

                        <!-- Submenu -->
                        <div *ngIf="isLeaveMenuOpen" class="mt-1 pl-11 space-y-1">
                            <a routerLink="/dashboard/leave/request" routerLinkActive="bg-blue-600/10 text-blue-400 font-semibold"
                                class="block px-3 py-2 -ml-3 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800/50 transition-colors">
                                Leave Request
                            </a>
                            <a *ngIf="(user$ | async)?.role !== 'employee' && (user$ | async)?.role !== 'staff'"
                                routerLink="/dashboard/leave/my-applications"
                                routerLinkActive="bg-blue-600/10 text-blue-400 font-semibold"
                                class="block px-3 py-2 -ml-3 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800/50 transition-colors">
                                My Leave Application
                            </a>
                        </div>
                    </div>

                    <a routerLink="/dashboard/my-payroll"
                        routerLinkActive="bg-blue-600 text-white shadow-lg shadow-blue-600/20"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group mb-1 relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                            </path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Payroll</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Payroll
                        </span>
                    </a>

                    <a routerLink="/dashboard/hr/performance"
                        routerLinkActive="bg-blue-600 text-white shadow-lg shadow-blue-600/20"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group mb-1 relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z">
                            </path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Performance</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Performance
                        </span>
                    </a>

                    <a routerLink="/dashboard/hr/training"
                        routerLinkActive="bg-blue-600 text-white shadow-lg shadow-blue-600/20"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group mb-1 relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                            </path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Training</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Training
                        </span>
                    </a>

                    <a routerLink="/dashboard/hr/reports"
                        routerLinkActive="bg-blue-600 text-white shadow-lg shadow-blue-600/20"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group mb-1 relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
                            </path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Reports</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Reports
                        </span>
                    </a>

                    <a routerLink="/dashboard/hr/settings"
                        routerLinkActive="bg-blue-600 text-white shadow-lg shadow-blue-600/20"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group mb-1 relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z">
                            </path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Settings</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Settings
                        </span>
                    </a>
                </ng-container>

                <!-- Employee Links -->
                <ng-container
                    *ngIf="['employee', 'staff', 'manager', 'supervisor', 'accountant', 'cto'].includes(user.role)">
                    <a routerLink="/dashboard/employee-profile"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">My Profile</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            My Profile
                        </span>
                    </a>
                    <!-- Leave Dropdown -->
                    <div class="mb-1 relative" routerLinkActive="active-parent" #empLeaveRla="routerLinkActive">
                        <button (click)="toggleLeaveMenu()" [class.bg-slate-800]="isLeaveMenuOpen || empLeaveRla.isActive"
                            [class.text-white]="isLeaveMenuOpen || empLeaveRla.isActive"
                            class="w-full flex items-center justify-between px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group"
                            [class.justify-center]="isCollapsed">
                            <div class="flex items-center">
                                <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                                    [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                                    </path>
                                </svg>
                                <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Leave</span>
                            </div>
                            <svg [class.rotate-180]="isLeaveMenuOpen" *ngIf="!isCollapsed"
                                class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Leave
                        </span>

                        <!-- Submenu -->
                        <div *ngIf="isLeaveMenuOpen" class="mt-1 pl-11 space-y-1">
                            <a routerLink="/dashboard/leave/request" routerLinkActive="bg-blue-600/10 text-blue-400 font-semibold"
                                class="block px-3 py-2 -ml-3 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800/50 transition-colors">
                                Leave Request
                            </a>
                            <a routerLink="/dashboard/leave/my-applications"
                                routerLinkActive="bg-blue-600/10 text-blue-400 font-semibold"
                                class="block px-3 py-2 -ml-3 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-800/50 transition-colors">
                                My Leave Application
                            </a>
                        </div>
                    </div>
                    <a routerLink="/dashboard/time-attendance"
                        routerLinkActive="bg-blue-600 text-white shadow-lg shadow-blue-600/20"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group mt-1 relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Attendance</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Attendance
                        </span>
                    </a>
                </ng-container>

                <!-- Manager/Supervisor Links -->
                <ng-container *ngIf="user.role === 'manager' || user.role === 'supervisor'">
                    <a href="#"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                            </path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Team</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Team
                        </span>
                    </a>
                    <a href="#"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                            </path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Reports</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Reports
                        </span>
                    </a>
                </ng-container>

                <!-- Accountant Links -->
                <ng-container *ngIf="user.role === 'accountant'">
                    <a href="#"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                            </path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Payroll</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Payroll
                        </span>
                    </a>
                    <a href="#"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z">
                            </path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Expenses</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Expenses
                        </span>
                    </a>
                </ng-container>

                <!-- CTO Links -->
                <ng-container *ngIf="user.role === 'cto'">
                    <a href="#"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Tech Overview</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Tech Overview
                        </span>
                    </a>
                    <a href="#"
                        class="flex items-center px-4 py-3 text-slate-300 rounded-xl hover:bg-slate-800 hover:text-white transition-all duration-200 group relative"
                        [class.justify-center]="isCollapsed">
                        <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-blue-400 transition-colors"
                            [class.mr-3]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                            </path>
                        </svg>
                        <span class="font-medium whitespace-nowrap" *ngIf="!isCollapsed">Reports</span>
                        <!-- Tooltip -->
                        <span *ngIf="isCollapsed"
                            class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                            Reports
                        </span>
                    </a>
                </ng-container>
            </ng-container>
        </nav>

        <!-- User Profile & Logout -->
        <div class="p-4 border-t border-slate-800 overflow-hidden">
            <!-- Notifications Badge -->
            <div class="mb-4 px-2" [class.flex]="isCollapsed" [class.justify-center]="isCollapsed"
                [class.mb-6]="isCollapsed">
                <div class="flex items-center p-3 bg-slate-800/50 rounded-xl border border-slate-800 hover:border-blue-600/50 transition-all group cursor-pointer relative"
                    [class.justify-between]="!isCollapsed" [class.justify-center]="isCollapsed"
                    [class.w-full]="!isCollapsed" [class.w-10]="isCollapsed" [class.h-10]="isCollapsed"
                    [class.p-0]="isCollapsed">
                    <div class="flex items-center gap-3 text-slate-300 group-hover:text-white"
                        [class.justify-center]="isCollapsed">
                        <div class="relative flex items-center justify-center">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
                                </path>
                            </svg>
                            <span *ngIf="notificationService.getUnreadCount() > 0"
                                class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-blue-600 text-[10px] font-bold text-white ring-2 ring-slate-900 animate-pulse">
                                {{ notificationService.getUnreadCount() }}
                            </span>
                        </div>
                        <span class="text-sm font-medium" *ngIf="!isCollapsed">Notifications</span>
                    </div>
                    <!-- Tooltip -->
                    <span *ngIf="isCollapsed"
                        class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                        Notifications
                    </span>
                </div>
            </div>

            <div *ngIf="user$ | async as user" class="flex items-center gap-3 mb-4 px-2"
                [class.justify-center]="isCollapsed">
                <div
                    class="w-10 h-10 min-w-[2.5rem] rounded-full bg-gradient-to-tr from-blue-500 to-purple-500 flex items-center justify-center text-white font-bold text-lg shadow-lg">
                    {{ user.username.charAt(0).toUpperCase() }}
                </div>
                <div class="flex-1 min-w-0" *ngIf="!isCollapsed">
                    <p class="text-sm font-medium text-white truncate">{{ user.username }}</p>
                    <p class="text-xs text-slate-400 truncate uppercase">{{ user.designation || user.role }}</p>
                </div>
            </div>
            <button (click)="logout()"
                class="w-full flex items-center justify-center px-4 py-2.5 bg-slate-800 hover:bg-red-600/90 text-slate-300 hover:text-white rounded-xl transition-all duration-200 group relative">
                <svg class="w-5 h-5 min-w-[1.25rem] group-hover:text-white transition-colors"
                    [class.mr-2]="!isCollapsed" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1">
                    </path>
                </svg>
                <span class="font-medium text-sm whitespace-nowrap" *ngIf="!isCollapsed">Sign Out</span>
                <!-- Tooltip -->
                <span *ngIf="isCollapsed"
                    class="fixed left-20 bg-slate-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity z-[60] ml-2 pointer-events-none whitespace-nowrap font-medium shadow-md">
                    Sign Out
                </span>
            </button>
        </div>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Mobile Header -->
        <header
            class="md:hidden bg-white border-b border-gray-200 h-16 flex items-center justify-between px-4 sticky top-0 z-30">
            <div class="flex items-center gap-3">
                <button (click)="toggleSidebar()" class="text-gray-500 hover:text-gray-700 focus:outline-none">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
                <span class="text-lg font-bold text-gray-800">Nexus<span class="text-blue-600">HR</span></span>
            </div>
            <div *ngIf="user$ | async as user"
                class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm">
                {{ user.username.charAt(0).toUpperCase() }}
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 scroll-smooth">
            <div class="w-full mx-auto">
                <router-outlet></router-outlet>
            </div>
        </main>
    </div>
</div>